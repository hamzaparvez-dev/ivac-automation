# ============================================
# IVAC AUTOMATION - Production-ready template
# Copy to .env and fill in secrets. Never commit .env.
# ============================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
JWT_SECRET=generate_a_long_random_string

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/ivac_automation
# Atlas: use mongodb+srv://.../ivac_automation?retryWrites=true&w=majority
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_MAX_POOL_SIZE=10
# Optional — reserved for a future Bull/Redis worker; not used by the in-process p-queue today
# REDIS_URL=redis://localhost:6379

# --- HTTP / security ---
TRUST_PROXY=true
# Comma-separated origins, or * for any (dev only).
# In production, the server will refuse to start if CORS_ORIGINS includes '*'.
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
WEBHOOK_RATE_LIMIT_MAX=60

# --- IVAC Site ---
IVAC_BASE_URL=https://www.ivacbd.com
IVAC_ONLINE_URL=https://www.ivacbd.com/for-bangladeshi
IVAC_LOGIN_URL=https://www.ivacbd.com/login
IVAC_SLOT_CHECK_INTERVAL=5000
IVAC_SLOT_OPEN_HOUR=17
IVAC_SLOT_OPEN_MINUTE=0
IVAC_SLOT_PREWARM_SECONDS=30
IVAC_TIMEZONE=Asia/Dhaka

# --- OTP (Bangladesh) ---
# Primary: MiMSMS inbound SMS polling — https://www.mimsms.com.bd/smsAPI?getinbox
MIMSMS_API_KEY=
MIMSMS_API_TOKEN=
MIMSMS_VIRTUAL_NUMBER=
# MIMSMS_INBOX_LIST=unread
# MIMSMS_POLL_INTERVAL_MS=3000

# Fallback: Android SMS forwarder -> POST /api/otp/webhook
# In production, the server will refuse to start unless OTP_WEBHOOK_SECRET (or OTP_SERVER_API_KEY) is set.
OTP_WEBHOOK_SECRET=
OTP_WAIT_TIMEOUT=120000
OTP_POLL_INTERVAL=3000

# Optional: self-hosted OTP server (diptosaya/otp-server)
OTP_SERVER_URL=
OTP_SERVER_API_KEY=

# Manual OTP via POST /api/otp/manual — dev/admin only (never for agency clients)
# OTP_ALLOW_MANUAL=false

# --- Captcha ---
# 2captcha (default) or anticaptcha
CAPTCHA_SERVICE=2captcha
# Production: set the key matching CAPTCHA_SERVICE (TWOCAPTCHA_* or ANTICAPTCHA_*).
TWOCAPTCHA_API_KEY=
ANTICAPTCHA_API_KEY=

# --- Notifications ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Browser ---
HEADLESS=true
BROWSER_TIMEOUT=30000
SLOW_MO=50
PROXY_LIST=

MAX_CONCURRENT_BROWSERS=5
QUEUE_CONCURRENCY=3
PIPELINE_QUEUE_MAX_WAITING=30

# Block images/fonts (default off). Aggressive blocking can look less human.
BLOCK_MEDIA=false
# During slot-monitor login iterations, block media unless false
SLOT_MONITOR_BLOCK_MEDIA=true

# Playwright tracing / verbose debug on failure (logs + screenshots; see browser.js)
TRACE_ON_FAILURE=false
DEBUG_PW=false

MAX_RETRIES=5
RETRY_DELAY=3000

# --- Payment (SSLCommerz validation / callbacks) ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_SANDBOX=true

# Auto-payment is disabled for the Bangladesh launch (self/manual only).
# Keep these empty unless you intentionally re-enable auto-pay in code.
BKASH_PHONE=
BKASH_PIN=
CARD_NUMBER=
CARD_EXPIRY=
CARD_CVV=
CARD_NAME=
